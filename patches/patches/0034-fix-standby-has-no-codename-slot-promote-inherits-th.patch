+                placeholder="Marcus01"
+                disabled={isStandby}
+                style={{ width: '100%', boxSizing: 'border-box', background: 'var(--surface2)', border: '1px solid var(--border)', color: 'var(--text)', borderRadius: 7, padding: '8px 10px', fontSize: 13 }}
