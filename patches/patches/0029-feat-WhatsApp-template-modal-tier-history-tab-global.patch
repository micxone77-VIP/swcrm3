+
+  function addPrize() {
+    setPrizes(prev => [...prev, { label:'New Prize', prob:5, color:'#8b949e' }])
+  }
+
+  function removePrize(i) {
+    setPrizes(prev => prev.filter((_, idx) => idx !== i))
+  }
+
+  const TIERS = ['GOLD','PLATINUM','DIAMOND','BLACK']
