+        return { ...v, upgrade_date: upgradeDate, is_approx: isApprox, days_in_tier: daysInTier, monthly_valid_bet: monthlyVB, next_tier: nextTier, next_thresh: nextThresh, gap_to_next: gapToNext, progress_pct: progressPct }
