From 088685bd1afaccee9634e4c1ef5f4746697c75be Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 16 Sep 2026 14:30:34 +0000
Subject: [PATCH 01/39] fix: compute Days Inactive from snapshot data instead
 of stale CSV field

Replace vip_members.days_inactive (platform login-based CSV import value)
with a real calculation from vip_daily_snapshots. A 5th query fetches the
most recent snapshot date where monthly_valid_bet > 0 or total_deposit > 0
for each player (last 90 days), then daysVal = days since that date.
Players with no activity in 90 days show 'No data' instead of a misleading
login-based count.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DqGp4gVeTBMvwho4pP8n8C
---
 src/pages/ActiveTracker.jsx | 35 +++++++++++++++++++++++++++--------
 1 file changed, 27 insertions(+), 8 deletions(-)

diff --git a/src/pages/ActiveTracker.jsx b/src/pages/ActiveTracker.jsx
index ce86124..cc2914b 100644
--- a/src/pages/ActiveTracker.jsx
+++ b/src/pages/ActiveTracker.jsx
@@ -32,9 +32,10 @@ export default function ActiveTracker() {
       { data: thisSnap },
       { data: lastSnap },
       { data: monthSnap },
+      { data: lastActiveSnap },
     ] = await Promise.all([
       supabase.from('vip_members')
-        .select('id, username, full_name, tier, host_assigned, days_inactive')
+        .select('id, username, full_name, tier, host_assigned')
         .eq('is_excluded', false)
         .order('username'),
       supabase.from('vip_daily_snapshots')
@@ -49,12 +50,23 @@ export default function ActiveTracker() {
         .select('username, total_deposit, monthly_valid_bet')
         .gte('snapshot_date', monthStart).lte('snapshot_date', thisEnd)
         .or(ACTIVE_FILTER),
+      supabase.from('vip_daily_snapshots')
+        .select('username, snapshot_date')
+        .or(ACTIVE_FILTER)
+        .gte('snapshot_date', fmt(pad(90)))
+        .order('snapshot_date', { ascending: false }),
     ])
 
     const activeThisWeek  = new Set((thisSnap  || []).map(r => r.username))
     const activeLastWeek  = new Set((lastSnap  || []).map(r => r.username))
     const activeThisMonth = new Set((monthSnap || []).map(r => r.username))
 
+    // Build last-active-date map from snapshots (deposit or valid bet activity only)
+    const lastActiveDateMap = {}
+    ;(lastActiveSnap || []).forEach(r => {
+      if (!lastActiveDateMap[r.username]) lastActiveDateMap[r.username] = r.snapshot_date
+    })
+
     // normalise tier casing
     const norm = t => (t || '').toUpperCase()
 
@@ -64,7 +76,7 @@ export default function ActiveTracker() {
