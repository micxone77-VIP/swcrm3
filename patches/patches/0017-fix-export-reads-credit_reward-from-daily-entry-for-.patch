+                          const dep = isDailyMode ? (parseFloat(entry?.deposit_amount)||0) : playerDeposit(p)
+                          let rewardAmt = ''
+                          if (isDailyMode && selected?.is_multi_level) {
+                            const cr = parseFloat(entry?.credit_reward)||0
+                            rewardAmt = cr > 0 ? `RM ${cr.toLocaleString('en-MY')} Credit` : ''
