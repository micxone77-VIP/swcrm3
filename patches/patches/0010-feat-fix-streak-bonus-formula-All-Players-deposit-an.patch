+-- Add turnover_multiplier to campaigns table
+-- Used to display wagering requirement in WA notification messages
+-- e.g. turnover_multiplier = 3 means reward × 3 = required turnover before withdrawal
+
+ALTER TABLE campaigns
+  ADD COLUMN IF NOT EXISTS turnover_multiplier numeric(6,2) DEFAULT NULL;
+
+COMMENT ON COLUMN campaigns.turnover_multiplier IS 'Wagering multiplier for reward payout. E.g. 3 means players must wager reward_amount × 3 before they can withdraw.';
