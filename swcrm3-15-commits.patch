 for enum columns
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

activity_status, churn_risk, and tier are DB enums — sending '' causes
a 400 Bad Request. Clean the form before PATCH to convert '' → null.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WNVUMRAtYbcfmnHMnYyCvn
---
 src/pages/VIP360.jsx | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/pages/VIP360.jsx b/src/pages/VIP360.jsx
index d6797e5..339c331 100644
--- a/src/pages/VIP360.jsx
+++ b/src/pages/VIP360.jsx
@@ -189,7 +189,11 @@ export default function VIP360() {
 
   async function saveEdit() {
     setEditSaving(true)
-    const { error: err } = await supabase.from('vip_members').update(editForm).eq('id', id)
+    // Convert empty strings to null — enum columns reject '' with a 400
+    const clean = Object.fromEntries(
+      Object.entries(editForm).map(([k, v]) => [k, v === '' ? null : v])
+    )
+    const { error: err } = await supabase.from('vip_members').update(clean).eq('id', id)
     setEditSaving(false)
     if (err) { toast('Error: ' + err.message, 'error'); return }
